# ---------------------------------------------------------------------------
#  签名配置模板
#  使用方式：把本文件复制为同目录下的 keystore.properties 并填入自己的信息。
#  keystore.properties 与 .jks 文件已在 .gitignore 中排除，不会被提交。
# ---------------------------------------------------------------------------

# 密钥库路径，相对于项目根目录
storeFile=app/keystore/timetable.jks

# 密钥库口令
storePassword=changeit

# 密钥别名
keyAlias=timetable

# 密钥口令
keyPassword=changeit

# 生成新密钥库的命令（JDK 17）：
# keytool -genkeypair -v -keystore app/keystore/timetable.jks -alias timetable \
#   -keyalg RSA -keysize 2048 -validity 10000 \
#   -storepass changeit -keypass changeit \
#   -dname "CN=Timetable, OU=Dev, O=Personal, L=Beijing, ST=Beijing, C=CN"
